APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://hackjunction:local-dev-only@127.0.0.1:5432/hackjunction
TEST_DATABASE_URL=postgresql+psycopg://hackjunction:local-dev-only@127.0.0.1:5432/hackjunction_test
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
MIMO_MODE=live
PUBLISH_MODE=simulated
REQUEST_TIMEOUT_SECONDS=60
STORAGE_BACKEND=local
ASSET_DIR=var/assets
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Registration email: QQ SMTP authorization code, not the QQ login password.
MAIL_MODE=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=12
