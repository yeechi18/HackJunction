APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://hackjunction:local-dev-only@127.0.0.1:5432/hackjunction
TEST_DATABASE_URL=postgresql+psycopg://hackjunction:local-dev-only@127.0.0.1:5432/hackjunction_test
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
MIMO_MODE=live
PUBLISH_MODE=simulated
REQUEST_TIMEOUT_SECONDS=60
STORAGE_BACKEND=local
ASSET_DIR=var/assets
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Registration email: QQ SMTP authorization code, not the QQ login password.
MAIL_MODE=smtp
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=12

# Optional integrations: research analysis uses supplied sources; web search defaults off.
RESEARCH_PROVIDER=mimo
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428
ARK_RESEARCH_MODEL=
ARK_RESEARCH_EFFORT=low
COMPETITOR_SEARCH_ENABLED=false
COMPETITOR_SEARCH_PROVIDER=mimo
BRAVE_SEARCH_API_KEY=

# Optional automatic product images. Keep credentials backend-only.
# MiMo writes each product's art direction; Seedream generates the actual pixels.
SEEDREAM_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_ENABLED=false
SEEDREAM_AUTO_ON_UPLOAD=false
SEEDREAM_TIMEOUT_SECONDS=180
SEEDREAM_ORDER_ATTEMPT_LIMIT=12
